{
  "name": "gereni-menu",
  "version": "1.0.0",
  "description": "Menú editable de Gereni Bar y Restaurante, sincronizado desde Markdown hacia web e impresión.",
  "main": "index.js",
  "scripts": {
    "build:promos": "node tools/generate-promos-manifest.js",
    "build:fallback": "npm run build:promos && node tools/build-static-menu.js",
    "build:images": "node tools/process-images.js",
    "build:precache": "node tools/generate-precache-urls.js --only-highest",
    "check:all": "npm run build:fallback && npm run build:precache && npm run check:prices && npm run check:menu && npm run check:social && npm run test:sync && npm run test:scroll && npm run test:a11y && npm run test:sw && npm run test:precache && npm run test:home-actions && npm run test:markdownlint",
    "check:menu": "node tools/check-menu-render.js",
    "check:prices": "node tools/validate-prices.js",
    "check:social": "node tools/validate-social-links.js",
    "export:menu": "node tools/export-menu.js",
    "lint:md": "markdownlint '**/*.md' -p .markdownlintignore",
    "test:sync": "node tests/sync-menu.test.js",
    "test:scroll": "node tests/scroll-helper.test.js",
    "test:a11y": "node tests/accessibility.test.js",
    "test:sw": "node tests/service-worker.test.js",
    "test:precache": "node tests/precache-urls.test.js",
    "test:home-actions": "node tests/home-actions-i18n.test.js",
    "test:markdownlint": "node tests/markdownlint-config.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandgraal/gereni-menu.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sandgraal/gereni-menu/issues"
  },
  "homepage": "https://github.com/sandgraal/gereni-menu#readme",
  "devDependencies": {
    "jsdom": "^27.0.0",
    "markdownlint-cli": "^0.46.0",
    "puppeteer": "^24.24.0"
  },
  "dependencies": {
    "sharp": "^0.33.2"
  }
}
